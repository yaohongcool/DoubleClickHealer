<Window x:Class="DoubleClickHealer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="关于"
        Icon="/Assets/app.ico"
        Width="400" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Acrylic"
        ui:WindowHelper.CornerStyle="Round">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
        <Image Source="/Assets/app.ico" Width="72" Height="72"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock Text="双击修复器" FontSize="18" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />

        <TextBlock x:Name="VersionText" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,0" />

        <TextBlock Text="修复因微动或轴体老化产生的双击、连击与拖拽中断"
                   FontSize="12" MaxWidth="300" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />

        <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Hyperlink NavigateUri="https://github.com/yaohongcool/DoubleClickHealer"
                       RequestNavigate="Link_RequestNavigate"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                github.com/yaohongcool/DoubleClickHealer
            </Hyperlink>
        </TextBlock>

        <TextBlock Text="© 2026 DoubleClickHealer"
                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Center" Margin="0,24,0,0" />
    </StackPanel>
</Window>
