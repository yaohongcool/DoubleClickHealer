    <sys:String x:Key="StrConfigLoadFailed">Could not load settings. Defaults are being used.</sys:String>
    <sys:String x:Key="StrSaveFailed">Could not save settings. Check disk permissions.</sys:String>

    <sys:String x:Key="StrStartupFailed">Could not change the startup setting</sys:String>
    <sys:String x:Key="StrElevationApplying">Waiting for administrator approval…</sys:String>
