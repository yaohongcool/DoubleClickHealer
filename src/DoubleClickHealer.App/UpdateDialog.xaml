<Window x:Class="DoubleClickHealer.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="{DynamicResource StrCheckUpdate}"
        Icon="/Assets/app.ico"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{DynamicResource ContentControlThemeFontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="HeadlineText" FontSize="20" FontWeight="SemiBold"
                   Text="{DynamicResource StrCheckUpdate}"
                   HorizontalAlignment="Center" TextAlignment="Center" />

        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,10,0,0" />

        <Button x:Name="PrimaryButton" Content="{DynamicResource StrOk}"
                Style="{StaticResource AccentButtonStyle}"
                Click="PrimaryButton_Click"
                HorizontalAlignment="Center" MinWidth="96" Height="32"
                Margin="0,20,0,0" />
    </StackPanel>
</Window>
