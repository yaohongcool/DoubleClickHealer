<Window x:Class="DoubleClickHealer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双击修复器"
        Width="608" Height="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="24">
        <Border Background="{StaticResource BackgroundBrush}"
                CornerRadius="16"
                Effect="{StaticResource WindowShadow}" />

        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="D" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="双击修复器" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <Button Style="{StaticResource CircleButtonStyle}" Content="—"
                                Click="Minimize_Click" ToolTip="最小化到托盘" />
                        <Button Style="{StaticResource CloseButtonStyle}" Content="✕"
                                Click="Close_Click" ToolTip="关闭到托盘" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20,0,20,14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="防抖修复" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EnabledHint}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Enabled}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="20,0,20,14">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <StackPanel>
                                <TextBlock Text="开机自启" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="登录后自动在后台运行" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding RunAtStartup}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,10" />

                        <Grid Margin="0,2">
                            <StackPanel>
                                <TextBlock Text="增强模式" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="以管理员身份运行，覆盖管理员程序" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ElevatedMode}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="3" Margin="20,0,20,0" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
                    </ScrollViewer.Resources>

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButtonStyle}" Content="✕"
                                                        ToolTip="移除"
                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                              IsChecked="{Binding Enabled}"
                                                              Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Slider Grid.Column="0"
                                                    Style="{StaticResource MinimalSliderStyle}"
                                                    Minimum="0" Maximum="120"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    Value="{Binding HoldMs}" />

                                            <TextBlock Grid.Column="1" Text="{Binding HoldText}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="12,0,0,0" MinWidth="52" TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="4" Margin="20,14,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding AddButtonText}"
                            Command="{Binding AddRuleCommand}" />

                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
