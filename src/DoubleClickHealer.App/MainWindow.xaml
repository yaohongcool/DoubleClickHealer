<Window x:Class="DoubleClickHealer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="双击修复器"
        Width="640" Height="880"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="16" Height="16" CornerRadius="3" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="D" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="双击修复器" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;"
                        Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="最小化到托盘" />
                <Button Style="{StaticResource CloseCaptionButtonStyle}"
                        Content="&#xE8BB;"
                        Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="关闭到托盘" />
            </StackPanel>
        </Grid>

        <!-- Master switch -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="24,0,24,8">
            <Grid Margin="0,2">
                <StackPanel>
                    <TextBlock Text="防抖修复" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EnabledHint}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding Enabled}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Startup / elevation -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="24,0,24,8">
            <StackPanel>
                <Grid Margin="0,2">
                    <StackPanel>
                        <TextBlock Text="开机自启" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="登录后自动在后台运行" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding RunAtStartup}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{StaticResource StrokeSubtleBrush}" Margin="0,10" />

                <Grid Margin="0,2">
                    <StackPanel>
                        <TextBlock Text="增强模式" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="以管理员身份运行，覆盖管理员程序" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding ElevatedMode}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Key list -->
        <ScrollViewer Grid.Row="3" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
            </ScrollViewer.Resources>

            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="&#xE74D;"
                                                ToolTip="移除"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding Enabled}"
                                                      Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Slider Grid.Column="0"
                                            Style="{StaticResource Win11SliderStyle}"
                                            Minimum="0" Maximum="120"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Value="{Binding HoldMs}" />

                                    <TextBlock Grid.Column="1" Text="{Binding HoldText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="12,0,0,0" MinWidth="52" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="24,12,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Style="{StaticResource AccentButtonStyle}"
                    Content="{Binding AddButtonText}"
                    Command="{Binding AddRuleCommand}" />

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Window>
