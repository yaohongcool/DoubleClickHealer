<Window x:Class="DoubleClickHealer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        Title="设置"
        Icon="/Assets/app.ico"
        Width="560" Height="720"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.CornerStyle="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="20,12,20,0" VerticalScrollBarVisibility="Auto">
            <ikw:SimpleStackPanel Spacing="4">
                <!-- Master switch -->
                <ui:SettingsCard Header="启用" MinWidth="0">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Power_20_Regular}" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:ToggleSwitch IsOn="{Binding Enabled}" OnContent="开" OffContent="关" />
                </ui:SettingsCard>

                <!-- System settings + key list, disabled together with the master switch -->
                <StackPanel IsEnabled="{Binding Enabled}">
                    <ikw:SimpleStackPanel Spacing="4">
                        <ui:SettingsCard Header="开机自启" MinWidth="0"
                                         Description="登录 Windows 后自动在托盘中运行">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Rocket_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch IsOn="{Binding RunAtStartup}" OnContent="开" OffContent="关" />
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="增强模式" MinWidth="0"
                                         Description="以管理员权限运行，重启软件后生效">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Shield_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch IsOn="{Binding ElevatedMode}" OnContent="开" OffContent="关" />
                        </ui:SettingsCard>
                    </ikw:SimpleStackPanel>
                </StackPanel>

                <!-- Theme -->
                <ui:SettingsCard Header="主题" MinWidth="0"
                                 Description="跟随系统会随 Windows 深浅色设置自动切换">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.PaintBrush_20_Regular}" />
                    </ui:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{Binding ThemeIndex}"
                              MinWidth="0" Width="140">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </ui:SettingsCard>

                <!-- Key list -->
                <StackPanel IsEnabled="{Binding Enabled}">
                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:SettingsCard Header="{Binding Name}"
                                                     MinWidth="0"
                                                     IsActionIconVisible="False"
                                                     Margin="0,0,0,4">
                                        <ui:SettingsCard.HeaderIcon>
                                            <ui:FontIcon FontSize="20">
                                                <ui:FontIcon.Style>
                                                    <Style TargetType="ui:FontIcon">
                                                        <Setter Property="Icon"
                                                                Value="{x:Static ui:FluentSystemIcons.Keyboard_20_Regular}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouse}" Value="True">
                                                                <Setter Property="Icon"
                                                                        Value="{x:Static ui:SegoeFluentIcons.Mouse}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:FontIcon.Style>
                                            </ui:FontIcon>
                                        </ui:SettingsCard.HeaderIcon>

                                        <StackPanel Orientation="Horizontal">
                                            <ui:NumberBox Value="{Binding HoldMsValue, Mode=TwoWay}"
                                                          Minimum="0" Maximum="120"
                                                          SmallChange="5" LargeChange="10"
                                                          MinWidth="0" Width="104" FontSize="13"
                                                          TextAlignment="Right"
                                                          VerticalAlignment="Center" />
                                            <TextBlock Text="ms" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />

                                            <ui:ToggleSwitch IsOn="{Binding Enabled}"
                                                             OnContent="开" OffContent="关"
                                                             Margin="16,0,0,0" VerticalAlignment="Center" />

                                            <Button Width="32" Height="32" Padding="0"
                                                    Margin="10,0,0,0"
                                                    Background="Transparent" BorderBrush="Transparent"
                                                    ToolTip="移除"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_16_Regular}"
                                                             FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                    </ui:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>
            </ikw:SimpleStackPanel>
        </ScrollViewer>

        <!-- Footer: status line + add button -->
        <Grid Grid.Row="1" Margin="20,8,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,8"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Row="1" Style="{StaticResource AccentButtonStyle}"
                    Height="40" HorizontalAlignment="Stretch"
                    Command="{Binding AddRuleCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Add_16_Regular}"
                                 FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AddButtonText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
